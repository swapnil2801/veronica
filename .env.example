# VERONICA_CARTESIA_KEY=
# VERONICA_CARTESIA_VOICE=
# SARVAM_API_KEY=
# VERONICA_SARVAM_VOICE=ishita
# OPENROUTER_API_KEY=
# EXPLABS_API_KEY=
# ELEVENLABS_API_KEY=
# GEMINI_API_KEY=          # Google AI Studio key for Gemini TTS
